APP_NAME=Finans
APP_ENV=production
# Boş bırakın: ilk kurulumda cron üretir. Sonra ASLA değiştirmeyin.
APP_KEY=
APP_DEBUG=false
APP_URL=https://finans.yoklm.com

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Tablo motoru (varsayılan InnoDB; sunucunun varsayılanı MyISAM olsa da InnoDB kullanılır)
# DB_ENGINE=InnoDB

SESSION_DRIVER=database
# Oturum süresi config/session.php'de sabittir (1 yıl, sürekli açık)
SESSION_ENCRYPT=true
SESSION_PATH=/
# Çerez yalnızca finans.yoklm.com'a yazılır (okulun .yoklm.com çereziyle karışmasın). Değiştirmeyin.
SESSION_DOMAIN=null
SESSION_COOKIE=finans_oturum
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=finans.yoklm.com

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
# Şifre sıfırlama e-postası için SMTP (Turhost'ta bir e-posta hesabı açın, örn. noreply@yoklm.com; bilgileri YALNIZCA
# sunucudaki finans-app/.env'e yazın, depoya girmez). MAIL_MAILER=log iken "Şifremi unuttum" yöneticiye yönlendirir.
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=mail.yoklm.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=noreply@yoklm.com
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="noreply@yoklm.com"
# MAIL_FROM_NAME="Finans"

# Yapay zekâ ile ekstre analizi (isteğe bağlı; anahtar boşsa kapalı). Ayrıntı: docs/CANLI.md
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_PDF_DETAIL=high
EKSTRE_MAX_MB=10
EKSTRE_AI_MAX_MB=8
EKSTRE_AI_AKTARIM=true

# İlk kurulumda (hiç kullanıcı yokken) açılacak yönetici: "e-posta|Ad|Soyad". Geçici şifre deploy/kurulum.log'a yazılır.
KURULUM_YONETICI=""
