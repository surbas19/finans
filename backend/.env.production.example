APP_NAME=Finans
APP_ENV=production
# Boş bırakın: ilk kurulumda cron üretir. Sonra ASLA değiştirmeyin.
APP_KEY=
APP_DEBUG=false
APP_URL=https://finans.yoklm.com

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_PATH=/
# Çerez yalnızca finans.yoklm.com'a yazılır (okulun .yoklm.com çereziyle karışmasın). Değiştirmeyin.
SESSION_DOMAIN=null
SESSION_COOKIE=finans_oturum
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=finans.yoklm.com

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# İlk kurulumda (hiç kullanıcı yokken) açılacak yönetici: "e-posta|Ad|Soyad". Geçici şifre deploy/kurulum.log'a yazılır.
KURULUM_YONETICI=""
